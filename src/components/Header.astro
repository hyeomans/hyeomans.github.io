---
import { SITE_TITLE, NAV_ITEMS_EN, NAV_ITEMS_ES, SOCIAL_LINKS } from '../consts';
import DarkModeToggle from './DarkModeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { LanguageLink } from '../types/site';

interface Props {
	currentPath?: string;
	lang?: 'en' | 'es';
	languageLinks?: LanguageLink[];
}

const { currentPath = '/', lang = 'en', languageLinks } = Astro.props;
const navItems = lang === 'en' ? NAV_ITEMS_EN : NAV_ITEMS_ES;

const isActivePath = (href: string) => {
	if (href === '/') {
		return currentPath === '/';
	}
	return currentPath === href || currentPath.startsWith(href);
};
---

<header class="site-header sticky top-0 z-50 border-b border-gray-200/80 backdrop-blur-md dark:border-gray-800/80">
	<nav class="relative mx-auto max-w-7xl px-6 py-4 lg:px-8">
		<div class="flex items-center justify-between">
			<!-- Logo / Site Title -->
			<div class="flex-shrink-0">
				<a href="/" class="text-xl font-bold text-gray-900 dark:text-white hover:text-gamboge-600 dark:hover:text-gamboge-400 transition-colors">
					{SITE_TITLE}
				</a>
			</div>

			<!-- Desktop Navigation -->
			<div class="hidden md:flex md:items-center md:gap-8" role="navigation" aria-label="Primary">
				{navItems.map((item) => (
					<a
						href={item.href}
						class={`text-sm font-medium transition-colors ${
							isActivePath(item.href)
								? 'text-gamboge-600 dark:text-gamboge-400 border-b-2 border-gamboge-600 dark:border-gamboge-400'
								: 'text-gray-700 dark:text-gray-300 hover:text-gamboge-600 dark:hover:text-gamboge-400'
						}`}
					>
						{item.label}
					</a>
				))}
			</div>

			<!-- Social Links + Dark Mode Toggle -->
			<div class="flex items-center gap-4">
				<div class="hidden lg:block">
					<LanguageSwitcher currentLang={lang} links={languageLinks} />
				</div>

				<!-- Social Icons (hidden on mobile) -->
				<div class="hidden md:flex items-center gap-3">
					<a
						href={SOCIAL_LINKS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-600 hover:text-gamboge-600 dark:text-gray-400 dark:hover:text-gamboge-400 transition-colors"
						aria-label="GitHub"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
						</svg>
					</a>
					<a
						href={SOCIAL_LINKS.twitter}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-600 hover:text-gamboge-600 dark:text-gray-400 dark:hover:text-gamboge-400 transition-colors"
						aria-label="Twitter / X"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
						</svg>
					</a>
					<a
						href={SOCIAL_LINKS.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-600 hover:text-gamboge-600 dark:text-gray-400 dark:hover:text-gamboge-400 transition-colors"
						aria-label="LinkedIn"
					>
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
						</svg>
					</a>
				</div>

				<!-- Dark Mode Toggle -->
				<DarkModeToggle />

				<!-- Mobile Menu Button -->
				<button
					id="mobile-menu-btn"
					type="button"
					class="menu-button inline-flex size-9 items-center justify-center rounded-md text-gray-700 transition-colors hover:bg-gray-100 hover:text-gamboge-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gamboge-500 md:hidden dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gamboge-400"
					aria-controls="mobile-menu"
					aria-expanded="false"
					data-open="false"
				>
					<span class="sr-only">Open main menu</span>
					<span class="menu-icon" aria-hidden="true">
						<span class="menu-line"></span>
						<span class="menu-line"></span>
						<span class="menu-line"></span>
					</span>
				</button>
			</div>
		</div>

		<!-- Mobile Menu -->
		<div
			id="mobile-menu"
			class="mobile-menu md:hidden"
			data-open="false"
			aria-hidden="true"
			inert
		>
			<div class="flex flex-col gap-2" role="navigation" aria-label="Mobile">
				{navItems.map((item) => (
					<a
						href={item.href}
						class={`text-base font-medium px-3 py-2 rounded-md transition-colors ${
							isActivePath(item.href)
								? 'bg-gamboge-100 text-gamboge-900 dark:bg-gamboge-900 dark:text-gamboge-100'
								: 'text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800'
						}`}
					>
						{item.label}
					</a>
				))}
				<div class="flex justify-start px-3 py-2">
					<LanguageSwitcher currentLang={lang} links={languageLinks} />
				</div>

				<!-- Mobile Social Links -->
				<div class="flex items-center gap-4 px-3 py-2 border-t border-gray-200 dark:border-gray-700 mt-2 pt-4">
					<a
						href={SOCIAL_LINKS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-600 hover:text-gamboge-600 dark:text-gray-400 dark:hover:text-gamboge-400"
						aria-label="GitHub"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
						</svg>
					</a>
					<a
						href={SOCIAL_LINKS.twitter}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-600 hover:text-gamboge-600 dark:text-gray-400 dark:hover:text-gamboge-400"
						aria-label="Twitter / X"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
						</svg>
					</a>
					<a
						href={SOCIAL_LINKS.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="text-gray-600 hover:text-gamboge-600 dark:text-gray-400 dark:hover:text-gamboge-400"
						aria-label="LinkedIn"
					>
						<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
						</svg>
					</a>
				</div>
			</div>
		</div>

		<noscript>
			<style>
				#mobile-menu-btn { display: none !important; }
			</style>
			<div class="mt-4 border-t border-gray-200 pt-4 md:hidden dark:border-gray-800">
				<div class="flex flex-col gap-2" role="navigation" aria-label="Mobile">
					{navItems.map((item) => (
						<a
							href={item.href}
							class={`rounded-md px-3 py-2 text-base font-medium ${
								isActivePath(item.href)
									? 'bg-gamboge-100 text-gamboge-900 dark:bg-gamboge-900 dark:text-gamboge-100'
									: 'text-gray-700 dark:text-gray-300'
							}`}
						>
							{item.label}
						</a>
					))}
					<div class="px-3 py-2">
						<LanguageSwitcher currentLang={lang} links={languageLinks} />
					</div>
				</div>
			</div>
		</noscript>
	</nav>
</header>

<style>
	.site-header {
		background: color-mix(in srgb, var(--site-canvas) 90%, transparent);
	}

	.mobile-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 1.5rem;
		right: 1.5rem;
		padding: 0.75rem;
		border: 1px solid var(--site-line);
		border-radius: 0.75rem;
		background: var(--site-surface);
		box-shadow: 0 18px 45px rgb(17 24 39 / 0.12);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-0.5rem) scale(0.985);
		transform-origin: top right;
		transition:
			opacity 160ms ease,
			transform 220ms var(--motion-ease),
			visibility 0s linear 220ms;
	}

	.mobile-menu[data-open='true'] {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0) scale(1);
		transition-delay: 0s;
	}

	.menu-icon {
		position: relative;
		display: block;
		width: 1.25rem;
		height: 1rem;
	}

	.menu-line {
		position: absolute;
		left: 0;
		display: block;
		width: 100%;
		height: 1.5px;
		border-radius: 999px;
		background: currentColor;
		transition:
			transform 220ms var(--motion-ease),
			top 220ms var(--motion-ease),
			opacity 120ms ease;
	}

	.menu-line:nth-child(1) { top: 0; }
	.menu-line:nth-child(2) { top: calc(50% - 0.75px); }
	.menu-line:nth-child(3) { top: calc(100% - 1.5px); }

	.menu-button[data-open='true'] .menu-line:nth-child(1) {
		top: calc(50% - 0.75px);
		transform: rotate(45deg);
	}

	.menu-button[data-open='true'] .menu-line:nth-child(2) {
		opacity: 0;
		transform: scaleX(0.4);
	}

	.menu-button[data-open='true'] .menu-line:nth-child(3) {
		top: calc(50% - 0.75px);
		transform: rotate(-45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu,
		.menu-line {
			transition: none;
		}
	}
</style>

<script is:inline>
	const mobileMenuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');

	if (mobileMenuBtn && mobileMenu) {
		const buttonLabel = mobileMenuBtn.querySelector('.sr-only');
		const setMenu = (open) => {
			mobileMenuBtn.setAttribute('aria-expanded', open.toString());
			mobileMenuBtn.dataset.open = open.toString();
			mobileMenu.dataset.open = open.toString();
			mobileMenu.setAttribute('aria-hidden', (!open).toString());
			mobileMenu.inert = !open;
			if (buttonLabel) buttonLabel.textContent = open ? 'Close main menu' : 'Open main menu';
		};

		mobileMenuBtn.addEventListener('click', () => {
			setMenu(mobileMenuBtn.getAttribute('aria-expanded') !== 'true');
		});

		mobileMenu.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && mobileMenuBtn.getAttribute('aria-expanded') === 'true') {
				setMenu(false);
				mobileMenuBtn.focus();
			}
		});

		window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
			if (event.matches) setMenu(false);
		});
	}
</script>
