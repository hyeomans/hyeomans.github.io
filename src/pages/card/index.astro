---
import walletLinks from '../../data/generated-wallet-links.json';

const card = {
  name: 'Hector Yeomans',
  role: 'Staff Software Engineer',
  email: 'me@hyeomans.com',
  linkedin: 'https://www.linkedin.com/in/hector-yeomans/',
  url: 'https://hyeomans.com/card/',
};

const walletActions = [
  {
    name: 'Apple Wallet',
    eyebrow: 'SAVE TO',
    href: walletLinks.apple,
    symbol: '●',
  },
  {
    name: 'Google Wallet',
    eyebrow: 'ADD TO',
    href: walletLinks.google,
    symbol: '◆',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#151515" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="referrer" content="no-referrer" />
    <meta name="format-detection" content="telephone=no" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'self'; form-action 'none'"
    />
    <link rel="canonical" href={card.url} />
    <link rel="icon" type="image/svg+xml" href="/card/mark.svg" />
    <link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
    <title>{card.name} — Contact Card</title>
    <meta name="description" content={`A minimal contact card for ${card.name}.`} />
  </head>
  <body>
    <main>
      <article class="identity-card" aria-labelledby="card-name">
        <header class="card-header">
          <img src="/card/mark.svg" width="56" height="56" alt="" />
          <div class="serial" aria-label="Private contact card number one">
            <span>PRIVATE CONTACT</span>
            <strong>NO. 01</strong>
          </div>
        </header>

        <div class="identity-copy">
          <p class="kicker">ENGINEERING / SYSTEMS / LEADERSHIP</p>
          <h1 id="card-name">Hector<br />Yeomans</h1>
          <p class="role">{card.role}</p>
        </div>

        <section class="wallet-section" aria-labelledby="wallet-heading">
          <div class="section-heading">
            <h2 id="wallet-heading">Keep this card</h2>
            <span>01 / WALLET</span>
          </div>
          <div class="wallet-grid">
            {walletActions.map((wallet) => wallet.href ? (
              <a class="wallet-action" href={wallet.href}>
                <span class="wallet-symbol" aria-hidden="true">{wallet.symbol}</span>
                <span><small>{wallet.eyebrow}</small>{wallet.name}</span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="wallet-action is-pending" aria-disabled="true">
                <span class="wallet-symbol" aria-hidden="true">{wallet.symbol}</span>
                <span><small>SIGNING PENDING</small>{wallet.name}</span>
                <span class="status-dot" aria-hidden="true"></span>
              </span>
            ))}
          </div>
          {!walletLinks.apple || !walletLinks.google ? (
            <p class="wallet-note">Wallet passes are awaiting issuer signing. Direct contact remains available below.</p>
          ) : null}
        </section>

        <section class="contact-section" aria-labelledby="contact-heading">
          <div class="section-heading">
            <h2 id="contact-heading">Direct contact</h2>
            <span>02 / VERIFIED</span>
          </div>
          <div class="contact-links">
            <a href={`mailto:${card.email}`} rel="nofollow">
              <span>Email</span>
              <strong>{card.email}</strong>
              <span aria-hidden="true">↗</span>
            </a>
            <a href={card.linkedin} target="_blank" rel="nofollow noopener noreferrer">
              <span>LinkedIn</span>
              <strong>hector-yeomans</strong>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </article>

      <aside class="share-panel" aria-labelledby="share-heading">
        <div class="share-copy">
          <p class="kicker">NFC / QR</p>
          <h2 id="share-heading">One address.<br />Two ways in.</h2>
          <p>Tap the NFC card or scan the code. Both open this page; neither carries extra contact data.</p>
        </div>
        <figure>
          <div class="qr-frame">
            <img src="/card/qr.svg" width="220" height="220" alt="QR code for hyeomans.com/card" />
          </div>
          <figcaption>HYEOMANS.COM/CARD</figcaption>
        </figure>
        <p class="privacy-line"><span aria-hidden="true">●</span> PHONE + LOCATION OMITTED</p>
      </aside>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: "Atkinson";
    src: url("/fonts/atkinson-regular.woff") format("woff");
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "Atkinson";
    src: url("/fonts/atkinson-bold.woff") format("woff");
    font-weight: 700;
    font-display: swap;
  }

  :root {
    color-scheme: dark;
    --ink: #151515;
    --paper: #f6f0e5;
    --muted: #aba69c;
    --line: rgba(246, 240, 229, 0.18);
    --accent: #e09d1f;
    font-family: "Atkinson", sans-serif;
    background: var(--ink);
    color: var(--paper);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background:
      linear-gradient(rgba(246, 240, 229, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(246, 240, 229, 0.025) 1px, transparent 1px),
      var(--ink);
    background-size: 32px 32px;
  }

  main {
    width: min(1180px, 100%);
    min-height: 100vh;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, .85fr);
    border-inline: 1px solid var(--line);
  }

  .identity-card, .share-panel { padding: clamp(28px, 5vw, 76px); }

  .identity-card { border-right: 1px solid var(--line); }

  .card-header, .section-heading, .contact-links a, .wallet-action {
    display: flex;
    align-items: center;
  }

  .card-header { justify-content: space-between; }
  .card-header img { border-radius: 13px; }

  .serial {
    display: grid;
    gap: 2px;
    text-align: right;
    font-size: 11px;
    letter-spacing: .16em;
    color: var(--muted);
  }

  .serial strong { color: var(--paper); font-size: 13px; }

  .identity-copy { padding: clamp(72px, 12vh, 140px) 0 clamp(64px, 10vh, 112px); }

  .kicker {
    margin: 0 0 18px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  h1, h2, p { margin-top: 0; }

  h1 {
    max-width: 760px;
    margin-bottom: 26px;
    font-size: clamp(64px, 9.2vw, 132px);
    line-height: .78;
    letter-spacing: -.075em;
  }

  .role { margin: 0; color: var(--muted); font-size: clamp(18px, 2vw, 24px); }

  .wallet-section, .contact-section { border-top: 1px solid var(--line); padding-top: 24px; }
  .contact-section { margin-top: 54px; }

  .section-heading { justify-content: space-between; margin-bottom: 18px; }
  .section-heading h2 { margin: 0; font-size: 17px; letter-spacing: -.01em; }
  .section-heading span { color: var(--muted); font-size: 10px; letter-spacing: .16em; }

  .wallet-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }

  .wallet-action {
    min-height: 72px;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--paper);
    border-radius: 2px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    transition: transform 160ms ease, background-color 160ms ease;
  }

  a.wallet-action:hover { transform: translateY(-2px); background: #fffaf0; }
  a.wallet-action:focus-visible, .contact-links a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .wallet-action small { display: block; margin-bottom: 2px; font-size: 9px; letter-spacing: .13em; }
  .wallet-symbol { color: var(--accent); font-size: 18px; }
  .arrow, .status-dot { margin-left: auto; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }

  .wallet-action.is-pending {
    border-color: var(--line);
    background: transparent;
    color: var(--muted);
  }

  .wallet-note { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

  .contact-links { display: grid; }
  .contact-links a {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr) auto;
    gap: 12px;
    padding: 18px 2px;
    border-bottom: 1px solid var(--line);
    color: var(--paper);
    text-decoration: none;
  }

  .contact-links a > span:first-child { color: var(--muted); }
  .contact-links strong { overflow-wrap: anywhere; font-weight: 400; }
  .contact-links a:hover strong { color: var(--accent); }

  .share-panel { display: flex; flex-direction: column; justify-content: space-between; gap: 72px; }
  .share-copy h2 { margin-bottom: 26px; font-size: clamp(38px, 4.5vw, 62px); line-height: .95; letter-spacing: -.055em; }
  .share-copy > p:last-child { max-width: 34ch; color: var(--muted); line-height: 1.55; }

  figure { margin: auto 0; }
  .qr-frame { width: fit-content; padding: 13px; background: var(--paper); }
  .qr-frame img { display: block; width: min(220px, 46vw); height: auto; }
  figcaption { margin-top: 12px; color: var(--muted); font-size: 10px; letter-spacing: .18em; }

  .privacy-line { margin: 0; font-size: 10px; letter-spacing: .16em; }
  .privacy-line span { margin-right: 7px; color: var(--accent); }

  @media (max-width: 800px) {
    main { grid-template-columns: 1fr; border: 0; }
    .identity-card { border-right: 0; border-bottom: 1px solid var(--line); }
    .share-panel { min-height: 620px; }
    .identity-copy { padding-block: 80px; }
  }

  @media (max-width: 520px) {
    .wallet-grid { grid-template-columns: 1fr; }
    .identity-card, .share-panel { padding: 26px 22px; }
    .contact-links a { grid-template-columns: 72px minmax(0, 1fr) auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { scroll-behavior: auto !important; transition: none !important; }
  }
</style>
