---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugifyTag } from '../../utils/slug';

// Get all English posts and extract unique tags with counts
const posts = (await getCollection('posts'))
	.filter((post) => post.data.lang === 'en' && !post.data.draft);

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
	post.data.tags?.forEach((tag) => {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	});
});

// Sort tags alphabetically
const sortedTags = Array.from(tagCounts.entries())
	.sort((a, b) => a[0].localeCompare(b[0]))
	.map(([label, count]) => ({
		label,
		count,
		slug: slugifyTag(label),
	}));

const title = 'Software Engineering Topics';
const description = 'Browse articles by topic, including Go, TypeScript, microservices, software architecture, databases, testing, and open data.';
const languageLinks = [
	{ lang: 'en', href: '/tags/', label: 'EN', available: true, isTranslation: true },
	{ lang: 'es', href: '/es/tags/', label: 'ES', available: true, isTranslation: true },
];
---

<BaseLayout title={title} description={description} lang="en" languageLinks={languageLinks} canonicalUrl="/tags/">
	<div class="site-canvas py-16 sm:py-24">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<div class="page-intro mb-12" data-reveal>
				<h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
					{title}
				</h1>
				<p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
					{description}
				</p>
			</div>

			{sortedTags.length === 0 ? (
				<div class="text-center text-gray-600 dark:text-gray-400">
					<p>No tags found.</p>
				</div>
			) : (
				<div class="max-w-4xl">
					<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
						{sortedTags.map((tag) => (
							<a
								href={`/tags/${tag.slug}/`}
								class="editorial-card group flex items-center justify-between gap-4 p-5"
							>
								<span class="font-semibold text-gray-900 transition-colors group-hover:text-gamboge-600 dark:text-white dark:group-hover:text-gamboge-400">
									#{tag.label}
								</span>
								<span class="font-mono text-xs text-gray-500 dark:text-gray-400">
									{tag.count.toString().padStart(2, '0')} {tag.count === 1 ? 'post' : 'posts'}
								</span>
							</a>
						))}
					</div>
				</div>
			)}
		</div>
	</div>
</BaseLayout>
