# Copy this file to .env and fill in the values from your GitHub App settings.
GITHUB_CLIENT_ID=
GITHUB_PRIVATE_KEY_PATH=./data/your-app.private-key.pem

# Required for the organization card. Use the account where the app is installed.
GITHUB_ORG=

# Optional: debug, info, warn, or error. Use debug to trace token activity.
LOG_LEVEL=info
